[
    {
        "type": "commandBar",
        "extraButtons": [
            {
                "name": "btnPost",
                "command": "post",
                "caption": {
                    "i18n": "cash_receipt_post"
                },
                "icon": "/apps/general_icons/resources/public/16x16/post.png",
                "enabledWhen": {
                    "field": "postingState",
                    "in": [
                        "notPosted",
                        "error"
                    ]
                }
            },
            {
                "name": "btnUnpost",
                "command": "unpost",
                "caption": {
                    "i18n": "cash_receipt_unpost"
                },
                "icon": "/apps/general_icons/resources/public/16x16/unpost.png",
                "enabledWhen": {
                    "field": "postingState",
                    "in": [
                        "posted"
                    ]
                }
            },
            {
                "name": "btnMovements",
                "command": "movements",
                "confirm": false,
                "caption": {
                    "i18n": "mv_command"
                },
                "icon": "/apps/general_icons/resources/public/16x16/register.png"
            }
        ]
    },
    {
        "//": "Раскладка «для живого человека» (ТЗ платежей брони §4.2, ИНСТРУКЦИИ §3): на первой вкладке — то, что вводят почти всегда (сумма, способ, день; от кого и за что), на второй — реквизиты документа, место хранения и принадлежность, которые подставляются сами.",
        "type": "tabs",
        "name": "cashReceiptTabs",
        "tabs": [
            {
                "caption": {
                    "i18n": "cash_tab_payment"
                },
                "layout": [
                    {
                        "type": "group",
                        "caption": "",
                        "noBorder": true,
                        "orientation": "horizontal",
                        "layout": [
                            {
                                "type": "group",
                                "caption": {
                                    "i18n": "cash_group_amount"
                                },
                                "alignFields": true,
                                "orientation": "vertical",
                                "layout": [
                                    {
                                        "type": "number",
                                        "name": "amount",
                                        "data": "amount",
                                        "caption": {
                                            "i18n": "cash_amount_field"
                                        },
                                        "properties": {
                                            "width": 120,
                                            "minValue": 0
                                        }
                                    },
                                    {
                                        "type": "emunList",
                                        "name": "paymentMethod",
                                        "data": "paymentMethod",
                                        "caption": {
                                            "i18n": "cash_payment_method_field"
                                        },
                                        "properties": {
                                            "width": 140
                                        }
                                    },
                                    {
                                        "type": "date",
                                        "name": "operationDate",
                                        "data": "operationDate",
                                        "caption": {
                                            "i18n": "cash_operation_date_field"
                                        },
                                        "properties": {
                                            "showTime": false,
                                            "width": 120
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "group",
                                "caption": {
                                    "i18n": "cash_group_from_whom"
                                },
                                "alignFields": true,
                                "orientation": "vertical",
                                "layout": [
                                    {
                                        "type": "recordSelector",
                                        "name": "clientId",
                                        "data": "clientId",
                                        "caption": {
                                            "i18n": "Client"
                                        },
                                        "properties": {
                                            "width": 280,
                                            "selection": {
                                                "table": "clients",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    },
                                    {
                                        "type": "recordSelector",
                                        "name": "bookingId",
                                        "data": "bookingId",
                                        "caption": {
                                            "i18n": "cash_booking_field"
                                        },
                                        "properties": {
                                            "width": 280,
                                            "selection": {
                                                "table": "bookings",
                                                "idField": "UID",
                                                "displayField": "name",
                                                "where": {
                                                    "clientId": "{clientId}"
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "type": "recordSelector",
                                        "name": "operationTypeId",
                                        "data": "operationTypeId",
                                        "caption": {
                                            "i18n": "cash_operation_type_field"
                                        },
                                        "properties": {
                                            "width": 280,
                                            "selection": {
                                                "table": "cash_operation_types",
                                                "idField": "UID",
                                                "displayField": "name",
                                                "where": {
                                                    "direction": "in"
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "caption": "",
                        "noBorder": true,
                        "alignFields": true,
                        "orientation": "vertical",
                        "layout": [
                            {
                                "type": "textbox",
                                "name": "comment",
                                "data": "comment",
                                "caption": {
                                    "i18n": "Notes"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "caption": {
                    "i18n": "cash_tab_document"
                },
                "layout": [
                    {
                        "type": "group",
                        "caption": "",
                        "noBorder": true,
                        "orientation": "horizontal",
                        "layout": [
                            {
                                "type": "group",
                                "caption": {
                                    "i18n": "cash_group_document"
                                },
                                "alignFields": true,
                                "orientation": "vertical",
                                "layout": [
                                    {
                                        "type": "textbox",
                                        "name": "number",
                                        "data": "number",
                                        "caption": {
                                            "i18n": "number_field"
                                        },
                                        "properties": {
                                            "width": 120
                                        }
                                    },
                                    {
                                        "type": "date",
                                        "name": "date",
                                        "data": "date",
                                        "caption": {
                                            "i18n": "document_date_field"
                                        },
                                        "properties": {
                                            "width": 160
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "group",
                                "caption": {
                                    "i18n": "cash_group_place"
                                },
                                "alignFields": true,
                                "orientation": "vertical",
                                "layout": [
                                    {
                                        "type": "recordSelector",
                                        "name": "cashboxId",
                                        "data": "cashboxId",
                                        "caption": {
                                            "i18n": "cash_cashbox_field"
                                        },
                                        "properties": {
                                            "width": 220,
                                            "selection": {
                                                "table": "cashboxes",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "group",
                                "caption": {
                                    "i18n": "cash_group_assignment"
                                },
                                "alignFields": true,
                                "orientation": "vertical",
                                "layout": [
                                    {
                                        "type": "recordSelector",
                                        "name": "organizationId",
                                        "data": "organizationId",
                                        "caption": {
                                            "i18n": "Organization"
                                        },
                                        "properties": {
                                            "width": 220,
                                            "selection": {
                                                "table": "organizations",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    },
                                    {
                                        "type": "recordSelector",
                                        "name": "hotelId",
                                        "data": "hotelId",
                                        "caption": {
                                            "i18n": "Hotel"
                                        },
                                        "properties": {
                                            "width": 220,
                                            "selection": {
                                                "table": "hotels",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
