                                "i18n": "invoice_kind_storno"
                            }
                        },
                        {
                            "value": "correction",
                            "caption": {
                                "i18n": "invoice_kind_correction"
                            }
                        }
                    ]
                },
                "reportVariantId": {
                    "type": "STRING",
                    "allowNull": true,
                    "references": {
                        "model": "report_variants",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "SET NULL",
                    "caption": {
                        "i18n": "report_variant_field"
                    }
                }
            },
            "options": {
                "timestamps": true
            }
        },
