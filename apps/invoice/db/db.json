{
    "models": [
        {
            "name": "Invoices",
            "tableName": "invoices",
            "entityConfig": {
                "entityType": "document",
                "immutable": {
                    "field": "status",
                    "when": ["issued", "paid", "cancelled", "void"],
                    "except": ["status", "paidAt", "issuedAt"],
                    "transitions": {
                        "draft": ["issued"],
                        "issued": ["paid", "cancelled", "void"],
                        "paid": ["cancelled"]
                    },
                    "deletable": ["draft"],
                    "formEditable": ["paidAt"],
                    "commandStates": ["issued", "cancelled", "void"]
                },
                "invalidate": {
                    "status": "void",
                    "from": ["issued"],
                    "notice": { "i18n": "invoice_void_notice" },
                    "titleSelector": "h2"
                },
                "rowTones": [
                    { "when": { "field": "status", "in": ["void"] }, "tone": "rose" },
                    { "when": { "field": "status", "in": ["cancelled"] }, "tone": "red" },
                    { "when": { "field": "correctionKind", "in": ["storno"] }, "tone": "redDark" },
                    { "when": { "field": "correctionKind", "in": ["correction"] }, "tone": "pink" },
                    { "when": { "field": "status", "in": ["paid"] }, "tone": "green" },
                    { "when": { "field": "status", "in": ["draft"] }, "tone": "yellow" }
                ],
                "storno": {
                    "link": "correctsInvoiceId",
                    "kindField": "correctionKind",
                    "kindValue": "storno",
                    "negate": ["prepayment"],
                    "cancelStatus": "cancelled",
                    "copyExclude": ["status", "issuedAt", "paidAt", "correctsInvoiceId", "correctionKind"],
                    "hook": "invoice.onStorno"
                },
                "correction": {
                    "link": "correctsInvoiceId",
                    "kindField": "correctionKind",
                    "kindValue": "correction",
                    "copyExclude": ["status", "issuedAt", "paidAt", "correctsInvoiceId", "correctionKind"],
                    "difference": {
                        "section": "invoice_lines",
                        "targetTable": "invoice_target_lines",
                        "targetCaption": { "i18n": "invoice_target_lines_tab" },
                        "matchBy": ["serviceId", "bookingRoomId", "taxComponentName", "taxRate", "taxCategoryId", "unitPrice"],
                        "quantity": "quantity",
                        "price": "unitPrice",
                        "amount": "amount",
                        "order": "sortOrder"
                    }
                },
                "auditLog": true
            },
            "fields": {
                "name": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "name_field" }
                },
                "organizationId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "organizations",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "Organization" }
                },
                "hotelId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "hotels",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": { "i18n": "Hotel" }
                },
                "clientId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "clients",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": { "i18n": "Client" }
                },
                "dueDate": {
                    "type": "DATEONLY",
                    "allowNull": true,
                    "caption": { "i18n": "due_date" }
                },
                "status": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "draft",
                    "caption": { "i18n": "Status" },
                    "inputType": "emunList",
                    "options": [
                        { "value": "draft",     "caption": { "i18n": "invoice_status_draft" } },
                        { "value": "issued",    "caption": { "i18n": "invoice_status_issued" } },
                        { "value": "paid",      "caption": { "i18n": "invoice_status_paid" } },
                        { "value": "cancelled", "caption": { "i18n": "invoice_status_cancelled" } },
                        { "value": "void",      "caption": { "i18n": "invoice_status_void" } }
                    ]
                },
                "prepayment": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": { "i18n": "prepayment_field" }
                },
                "notes": {
                    "type": "TEXT",
                    "allowNull": true,
                    "caption": { "i18n": "Notes" }
                },
                "discountValue": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": { "i18n": "discount_value_field" }
                },
                "discountMode": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "percent",
                    "caption": { "i18n": "discount_mode_field" },
                    "inputType": "emunList",
                    "options": [
                        { "value": "percent", "caption": "%" },
                        { "value": "amount",  "caption": "€" }
                    ]
                },
                "issuedAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "invoice_issued_at" }
                },
                "paidAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "invoice_paid_at" }
                },
                "correctsInvoiceId": {
                    "type": "STRING",
                    "allowNull": true,
                    "references": {
                        "model": "invoices",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": { "i18n": "invoice_corrects_field" }
                },
                "correctionKind": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "invoice_correction_kind_field" },
                    "inputType": "emunList",
                    "options": [
                        { "value": "storno", "caption": { "i18n": "invoice_kind_storno" } },
                        { "value": "correction", "caption": { "i18n": "invoice_kind_correction" } }
                    ]
                },
                "reportVariantId": {
                    "type": "STRING",
                    "allowNull": true,
                    "references": {
                        "model": "report_variants",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "SET NULL",
                    "caption": { "i18n": "report_variant_field" }
                }
            },
            "options": {
                "timestamps": true
            }
        },
