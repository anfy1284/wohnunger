                    "caption": {
                        "i18n": "invoice_paid_at"
                    }
                },
                "correctsInvoiceId": {
                    "type": "STRING",
                    "allowNull": true,
                    "references": {
                        "model": "invoices",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": {
                        "i18n": "invoice_corrects_field"
                    }
                },
                "correctionKind": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": {
                        "i18n": "invoice_correction_kind_field"
                    },
                    "inputType": "emunList",
                    "options": [
                        {
                            "value": "storno",
