                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": {
                        "i18n": "Hotel"
                    }
                },
                "clientId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "clients",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": {
                        "i18n": "Client"
                    }
                },
                "dueDate": {
                    "type": "DATEONLY",
                    "allowNull": true,
                    "caption": {
                        "i18n": "due_date"
                    }
                },
                "status": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "draft",
                    "caption": {
                        "i18n": "Status"
                    },
                    "inputType": "emunList",
                    "options": [
                        {
                            "value": "draft",
                            "caption": {
                                "i18n": "invoice_status_draft"
                            }
                        },
                        {
                            "value": "issued",
                            "caption": {
                                "i18n": "invoice_status_issued"
                            }
                        },
                        {
                            "value": "paid",
                            "caption": {
                                "i18n": "invoice_status_paid"
                            }
                        },
                        {
                            "value": "cancelled",
                            "caption": {
                                "i18n": "invoice_status_cancelled"
                            }
                        },
                        {
                            "value": "void",
                            "caption": {
                                "i18n": "invoice_status_void"
                            }
                        }
                    ]
                },
                "prepayment": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": {
                        "i18n": "prepayment_field"
                    }
                },
                "notes": {
                    "type": "TEXT",
                    "allowNull": true,
                    "caption": {
                        "i18n": "Notes"
                    }
                },
                "discountValue": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": {
                        "i18n": "discount_value_field"
                    }
                },
                "discountMode": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "percent",
                    "caption": {
                        "i18n": "discount_mode_field"
                    },
                    "inputType": "emunList",
                    "options": [
                        {
                            "value": "percent",
