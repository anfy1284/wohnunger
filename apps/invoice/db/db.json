{
    "models": [
        {
            "name": "Invoices",
            "tableName": "invoices",
            "entityConfig": {
                "entityType": "document",
                "immutable": {
                    "field": "status",
                    "when": [
                        "issued",
                        "paid",
                        "cancelled",
                        "void"
                    ],
                    "except": [
                        "status",
                        "paidAt",
                        "issuedAt"
                    ],
                    "transitions": {
                        "draft": [
                            "issued"
                        ],
                        "issued": [
                            "paid",
                            "cancelled",
                            "void"
                        ],
                        "paid": [
                            "cancelled"
                        ]
                    },
                    "deletable": [
                        "draft"
                    ],
                    "formEditable": [
                        "paidAt"
                    ],
                    "commandStates": [
                        "issued",
                        "cancelled",
                        "void"
                    ]
                },
                "invalidate": {
                    "status": "void",
                    "from": [
                        "issued"
                    ],
                    "notice": {
                        "i18n": "invoice_void_notice"
                    },
                    "titleSelector": "h2"
                },
                "rowTones": [
                    {
                        "when": {
                            "field": "status",
                            "in": [
                                "void"
                            ]
                        },
                        "tone": "rose"
                    },
                    {
                        "when": {
                            "field": "status",
                            "in": [
                                "cancelled"
                            ]
                        },
                        "tone": "red"
                    },
                    {
                        "when": {
                            "field": "correctionKind",
                            "in": [
                                "storno"
                            ]
                        },
                        "tone": "redDark"
                    },
                    {
                        "when": {
                            "field": "correctionKind",
                            "in": [
                                "correction"
                            ]
                        },
                        "tone": "pink"
                    },
                    {
                        "when": {
                            "field": "status",
                            "in": [
                                "paid"
                            ]
                        },
                        "tone": "green"
                    },
                    {
                        "when": {
                            "field": "status",
                            "in": [
                                "draft"
                            ]
                        },
                        "tone": "yellow"
                    }
                ],
                "storno": {
                    "link": "correctsInvoiceId",
                    "kindField": "correctionKind",
                    "kindValue": "storno",
                    "negate": [
                        "prepayment"
                    ],
                    "cancelStatus": "cancelled",
                    "copyExclude": [
                        "status",
                        "issuedAt",
                        "paidAt",
                        "correctsInvoiceId",
                        "correctionKind"
                    ],
                    "hook": "invoice.onStorno"
                },
                "correction": {
                    "link": "correctsInvoiceId",
                    "kindField": "correctionKind",
                    "kindValue": "correction",
                    "copyExclude": [
                        "status",
                        "issuedAt",
                        "paidAt",
                        "correctsInvoiceId",
                        "correctionKind"
                    ],
                    "difference": {
                        "section": "invoice_lines",
                        "targetTable": "invoice_target_lines",
                        "targetCaption": {
                            "i18n": "invoice_target_lines_tab"
                        },
                        "//matchBy": "Чем строка коррекции опознаётся как «та же позиция», что строка исходного счёта. Это НЕ ключ позиции регистра услуг (apps/common/lib/bookingServices.js): там спрашивают «что ещё не выставлено» и цена в ключ не входит, а здесь сравниваются два снимка ОДНОЙ И ТОЙ ЖЕ пары документов, и смена цены обязана читаться как другая позиция — иначе разница поехала бы. Ссылка на компонент добавлена РЯДОМ с его именем, а не вместо: у строк, выставленных до появления ссылки, она пуста, и по имени они продолжают сопоставляться.",
                        "matchBy": [
                            "serviceId",
                            "bookingRoomId",
                            "taxComponentId",
                            "taxComponentName",
                            "taxRate",
                            "taxCategoryId",
                            "unitPrice"
                        ],
                        "quantity": "quantity",
                        "price": "unitPrice",
                        "amount": "amount",
                        "order": "sortOrder"
                    }
                },
                "auditLog": true,
                "posting": {
                    "//": "Для счёта «выставлен» = «проведён» (ТЗ §5.3). Команда на форме называется «Выставить», а не «Провести»: подписи объявляются потаблично.",
                    "mode": "manual",
                    "handler": "invoice.postIssue",
                    "//unpost": "Распроведение разрешено по умолчанию; выставленный счёт — особый случай: он напечатан и отдан клиенту (GoBD). Исправляется встречным документом — сторно или коррекцией.",
                    "unpost": false,
                    "//confirm": "Переспрос принадлежит КОМАНДЕ, а не кнопке: его показывает и «Выставить», и «Выставить и напечатать», и стандартный «ОК», если бы он проводил. Выставление необратимо — счёт получает номер, архивную копию и уходит клиенту.",
                    "confirm": {
                        "i18n": "issue_invoice_confirm"
                    },
                    "captions": {
                        "post": {
                            "i18n": "issue_invoice_btn"
                        },
                        "postAndClose": {
                            "i18n": "invoice_issue_and_close_btn"
                        },
                        "state": {
                            "i18n": "posting_state_field"
                        }
                    },
                    "writes": [
                        "reg_settlements",
                        "reg_booking_services"
                    ],
                    "writesTables": [],
                    "depends": [],
                    "statusOnPost": "issued",
                    "statusOnUnpost": null
                }
            },
            "fields": {
                "name": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": {
                        "i18n": "name_field"
                    }
                },
                "organizationId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "organizations",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": {
                        "i18n": "Organization"
                    }
                },
                "hotelId": {
                    "type": "STRING",
