                "checkIn": {
                    "type": "DATEONLY",
                    "allowNull": false,
                    "caption": { "i18n": "check_in" }
                },
                "checkOut": {
                    "type": "DATEONLY",
                    "allowNull": false,
                    "caption": { "i18n": "check_out" }
                },
                "statusId": {
