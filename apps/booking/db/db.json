{
    "models": [
        {
            "name": "Bookings",
            "tableName": "bookings",
            "entityConfig": {
                "entityType": "document",
                "hooks": {
                    "beforeCreate": [
                        {
                            "handler": "booking.onBeforeCreate"
                        }
                    ]
                },
                "//listAttributes": "Вычисляемые реквизиты ЖУРНАЛА (drive_root/db/listAttributes.js): величины, которых в таблице нет и быть не должно. Считает их метод onLoadListAttributes формы списка — ОДНИМ запросом на страницу строк. prepaymentPaid — СКОЛЬКО ВСЕГО ВНЕСЕНО по броне: движения регистра расчётов от денежных документов (поступление +, возврат −), без зачёта счётом (21.10.2026, ТЗ платежей брони §4.1 — «0» после счёта читался как «не платили»; незачтённый остаток по-прежнему берёт счёт). overInvoiced — сумма, на которую выставлено больше, чем заказано (ТЗ §8): отрицательный остаток регистра услуг, то есть автоматическое обнаружение случая § 17 Abs. 1 UStG. Пусто у строк без расхождения: «0,00» в каждой строке читается как данные и перестаёт читаться вовсе.",
                "listAttributes": [
                    {
                        "name": "prepaymentPaid",
                        "type": "DECIMAL(12,2)",
                        "caption": { "i18n": "prepayment_field" }
                    },
                    {
                        "name": "overInvoiced",
                        "type": "DECIMAL(12,2)",
                        "caption": { "i18n": "over_invoiced_field" }
                    }
                ],
                "//rowTones": "Строка брони с расхождением — красная. Правило читает тот же реквизит журнала: пусто (нет расхождения) правилу не подходит, любое значение — подходит. Отдельного флага для этого не заводим: признак один, и второй его экземпляр однажды разошёлся бы с первым.",
                "rowTones": [
                    {
                        "when": { "field": "overInvoiced", "notIn": [""] },
                        "tone": "red"
                    }
                ],
                "//posting": "Режим onSave: бронь уходит в очередь при каждом сохранении, команд проведения и слова «провести» на форме нет — владелица о проведении не узнаёт, а регистр услуг наполняется сам (ТЗ «Учёт услуг по брони», §6). Ключа unpost нет, то есть распроведение разрешено по умолчанию; кнопки у него в этом режиме всё равно нет, а практический путь к нему пользовательский — пометка на удаление снимает проведение в той же транзакции. depends пуст: бронь ничего из регистров не читает, перепроводить её за чужими движениями не нужно.",
                "posting": {
                    "mode": "onSave",
                    "handler": "booking.postServices",
                    "writes": [
                        "reg_booking_services"
                    ],
                    "writesTables": [],
                    "//creates": "Первый аванс новой брони (поля firstPrepayment…) проведение превращает в документ поступления — ОДИН раз, через ctx.createOnce со штампом firstPrepaymentReceiptId (ТЗ платежей брони §3.3, §4.1). Поступление живёт своей жизнью: перепроведение брони его не снимает и, если его удалили, не воскрешает.",
                    "creates": [
                        "cash_receipts"
                    ],
                    "depends": [],
                    "captions": {
                        "state": {
                            "i18n": "posting_state_field"
                        }
                    }
                }
            },
            "fields": {
                "//prepayment": "ВРЕМЕННО ВОЗВРАЩЕНО (16.10.2026, решение владельца). Старая хранимая предоплата брони. Её место заняли денежные документы, а на форме и в журнале — вычисляемый prepaymentBalance. Колонка оставлена ТОЛЬКО затем, чтобы миграция не стёрла её при первом старте новой версии в проде: скрипт tmp/2026-09-24_anzahlungen_uebertragen берёт суммы отсюда и превращает их в документы поступления. service: true — ни в автоформах, ни в журнале её не видно. Никакой код её не читает и не пишет, кроме того скрипта. Удалить на одном из следующих обновлений, ПОСЛЕ того как перенос выполнен в проде (tmp/БЕКЛОГ.md).",
                "prepayment": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": true,
                    "defaultValue": null,
                    "service": true,
                    "caption": { "i18n": "prepayment_field" }
                },
                "name": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "name_field" }
                },
                "//firstPrepayment": "АВАНС НОВОЙ БРОНИ (21.10.2026, ТЗ платежей брони §4.1). Сумма и способ вводятся прямо на форме НОВОЙ брони; документ поступления из них создаёт проведение брони — только успешное: не провелась — документа нет. Дата поступления — createdAt брони (момент ввода, серверное время; § 146 Abs. 1 Satz 2 AO), а не момент проведения: повтор после ошибки через полночь её не сдвигает. После создания поля на форме больше не показываются (решает реквизит формы firstPrepaymentOpen), а штамп firstPrepaymentReceiptId не даёт создать второй документ ни при каком перепроведении.",
                "firstPrepaymentAmount": {
                    "type": "DECIMAL(12,2)",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": { "i18n": "prepayment_field" }
                },
                "firstPrepaymentMethod": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "cash",
                    "defaultFromSetting": { "app": "cash", "key": "defaultPaymentMethod" },
                    "inputType": "emunList",
                    "options": [
                        { "value": "transfer", "caption": { "i18n": "cash_pm_transfer" } },
                        { "value": "card", "caption": { "i18n": "cash_pm_card" } },
                        { "value": "cash", "caption": { "i18n": "cash_pm_cash" } }
                    ],
                    "caption": { "i18n": "cash_payment_method_field" }
                },
                "//firstPrepaymentReceiptId": "ШТАМП: UID поступления, созданного из аванса. Пишет ядро (coreWrite, в транзакции проведения), человек — никогда. refersTo, а не references: поступление можно удалить (пометка + удаление помеченных), и штамп при этом НЕ сбрасывается — именно поэтому перепроведение брони удалённое поступление не воскрешает.",
                "firstPrepaymentReceiptId": {
                    "type": "STRING",
                    "allowNull": true,
                    "refersTo": "cash_receipts",
                    "service": true,
                    "caption": { "i18n": "first_prepayment_receipt_field" }
                },
                "organizationId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "organizations",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "Organization" }
                },
                "hotelId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "hotels",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
                    "caption": { "i18n": "Hotel" }
                },
                "clientId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": {
                        "model": "clients",
                        "key": "UID"
                    },
                    "onUpdate": "CASCADE",
                    "onDelete": "RESTRICT",
