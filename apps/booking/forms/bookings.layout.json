                                                "readOnly": true,
                                                "default": 0,
                                                "properties": { "width": 110 },
                                                "visibleWhen": { "field": "firstPrepaymentOpen", "notIn": ["true"] }
                                            },
                                            {
                                                "type": "emunList",
                                                "name": "firstPrepaymentMethod",
                                                "data": "firstPrepaymentMethod",
                                                "caption": "",
                                                "properties": { "width": 130 },
                                                "visibleWhen": { "field": "firstPrepaymentOpen", "in": ["true"] }
                                            }
