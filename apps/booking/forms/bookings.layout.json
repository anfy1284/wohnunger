                    {
                        "type": "group",
                        "caption": { "i18n": "Notes" },
                        "noBorder": true,
                        "orientation": "vertical",
                        "layout": [
                            {
                                "type": "textarea",
                                "name": "notes",
                                "data": "notes",
                                "caption": ""
                            }
                        ]
                    }
                ]
            },
            {
                "caption": { "i18n": "invoices_related_tab" },
                "layout": [
                    {
                        "type": "relatedList",
                        "name": "relInvoices",
                        "data": "related_invoices",
                        "caption": "",
                        "properties": {
                            "tableName": "invoices",
                            "fields": ["number", "date", "status", "name"],
                            "link": {
                                "via": "invoice_bookings",
                                "sourceField": "bookingId",
                                "targetField": "invoiceId"
                            },
                            "visibleRows": 10
                        },
                        "events": { "onDataRefreshed": "onInvoicesRefreshed" }
                    }
                ]
            },
            {
                "//": "ПЛАТЕЖИ БРОНИ (ТЗ платежей брони §3.2, §4.1): журнал денежных документов ядра с постоянным отбором по этой брони. «Добавить» спрашивает вид (поступление/выплата) и открывает новый документ, заполненный методом формы fillPaymentDocument. У несохранённой брони вкладки нет — платёж ссылался бы на запись, которой ещё нет; после первого сохранения она появляется без переоткрытия окна.",
                "caption": { "i18n": "booking_tab_payments" },
                "visibleWhen": { "saved": true },
                "layout": [
                    {
                        "type": "table",
                        "name": "payments",
                        "caption": "",
                        "properties": {
                            "dynamicTable": true,
                            "appName": "uniForm",
                            "tableName": "jrn_cash_documents",
                            "readOnly": true,
                            "showToolbar": true,
                            "visibleRows": 10,
                            "owner": {
                                "where": { "bookingId": "{UID}" },
                                "fill": "fillPaymentDocument"
                            },
                            "documents": ["cash_receipts", "cash_payments"],
                            "fields": ["docTable", "number", "operationDate", "paymentMethod", "cashboxId", "amount", "comment"],
                            "columnOverrides": {
                                "operationDate": { "width": 110, "showTime": false },
                                "amount": { "width": 110 },
                                "docTable": { "width": 150 },
                                "number": { "width": 90 }
                            },
                            "initialSort": [
                                { "field": "date", "order": "asc" },
                                { "field": "seq", "order": "asc" }
                            ],
                            "hiddenButtons": ["listSettings"]
                        }
                    }
                ]
            }
        ]
    }
