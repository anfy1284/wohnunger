                                                "caption": { "i18n": "document_date_field" },
                                                "properties": { "width": 110 }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "recordSelector",
                                        "name": "clientId",
                                        "data": "clientId",
                                        "caption": { "i18n": "Client" },
                                        "properties": {
                                            "showOpenButton": true,
                                            "selection": {
                                                "table": "clients",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    },
                                    {
                                        "//": "«Anzahlung» (ТЗ платежей брони §4.1). У НОВОЙ брони (и пока её аванс не стал документом) — поле ввода суммы и рядом «Zahlungsart»; документ поступления создаст проведение брони. У проведённой — СКОЛЬКО ВСЕГО ВНЕСЕНО, только чтение. Что показывать, решает реквизит firstPrepaymentOpen — его считает сервер (onLoadAttributes): штамп порождённого документа служебный и на форму не приходит.",
                                        "type": "group",
                                        "caption": { "i18n": "prepayment_field" },
                                        "noBorder": true,
                                        "orientation": "horizontal",
                                        "layout": [
                                            {
                                                "type": "attribute",
                                                "name": "firstPrepaymentOpen",
                                                "data": "firstPrepaymentOpen",
                                                "attribute": true,
                                                "default": true
                                            },
                                            {
                                                "type": "number",
                                                "name": "firstPrepaymentAmount",
                                                "data": "firstPrepaymentAmount",
                                                "caption": "",
                                                "properties": { "width": 110, "minValue": 0 },
                                                "visibleWhen": { "field": "firstPrepaymentOpen", "in": ["true"] }
                                            },
                                            {
                                                "type": "number",
                                                "name": "prepaymentPaid",
                                                "data": "prepaymentPaid",
                                                "caption": "",
