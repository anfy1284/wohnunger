                                            "selection": {
                                                "table": "booking_statuses",
                                                "idField": "UID",
                                                "displayField": "name"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "caption": "",
                        "noBorder": true,
                        "orientation": "horizontal",
                        "layout": [
                            {
                                "type": "group",
                                "caption": { "i18n": "booking_rooms_tab" },
                                "noBorder": true,
                                "orientation": "vertical",
                                "layout": [{
                                    "type": "table",
                                    "name": "ts_booking_rooms",
